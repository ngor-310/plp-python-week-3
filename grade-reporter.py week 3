scores = [72, 45, 90, 61, 38]

passed_count = 0
failed_count = 0
total_score = 0

for score in scores:
    total_score += score
    
    if score >= 80:
        grade = "A"
    elif score >= 70:
        grade = "B"
    elif score >= 50:
        grade = "C"
    else:
        grade = "F"
        
    if score >= 50:
        passed_count += 1
    else:
        failed_count += 1
        
    print(f"Score: {score} - Grade: {grade}")

average = total_score / len(scores)

print(f"\nLearners Passed: {passed_count}")
print(f"Learners Failed: {failed_count}")
print(f"Average Score: {round(average, 1)}")
